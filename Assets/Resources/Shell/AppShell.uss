.app-shell { flex-grow: 1; flex-direction: row; min-width: 0; min-height: 0; background-color: rgb(16,18,24); color: rgb(232,234,240); }
.sidebar { width: 250px; flex-shrink: 0; align-self: stretch; padding: 28px 18px; background-color: rgb(24,27,36); border-right-width: 1px; border-right-color: rgb(52,57,72); }
.brand { font-size: 28px; -unity-font-style: bold; margin-bottom: 2px; }
.brand-subtitle { color: rgb(150,157,177); margin-bottom: 28px; }
.nav-button { height: 42px; margin-bottom: 8px; -unity-text-align: middle-left; padding-left: 14px; background-color: rgb(31,35,45); border-width: 1px; border-color: rgba(255,255,255,0); border-radius: 6px; color: rgb(205,210,223); }
.nav-button:hover { background-color: rgb(39,44,57); border-color: rgb(70,77,96); color: white; }
.nav-button:active { background-color: rgb(49,57,78); }
.nav-button--active { background-color: rgb(61,73,112); border-color: rgb(85,100,145); color: white; }
.sidebar-spacer { flex-grow: 1; }
.stack-label { white-space: normal; color: rgb(117,124,144); font-size: 11px; }
.content { flex-grow: 1; min-width: 0; min-height: 0; }
.topbar { height: 72px; flex-direction: row; align-items: center; justify-content: space-between; padding-left: 32px; padding-right: 32px; border-bottom-width: 1px; border-bottom-color: rgb(52,57,72); }
.topbar-title { font-size: 18px; -unity-font-style: bold; }
.topbar-badge { color: rgb(167,176,203); }
.screen-host { flex-grow: 1; min-width: 0; min-height: 0; padding: 36px; }
.screen-instance { flex-grow: 1; min-width: 0; min-height: 0; }
.screen { flex-grow: 1; min-width: 0; min-height: 0; width: 100%; max-width: 900px; }
.eyebrow { color: rgb(136,150,199); text-transform: uppercase; letter-spacing: 2px; }
.title { font-size: 34px; -unity-font-style: bold; margin-top: 8px; margin-bottom: 8px; }
.subtitle { font-size: 15px; color: rgb(167,174,194); white-space: normal; margin-bottom: 28px; }
.card { padding: 24px; margin-bottom: 18px; background-color: rgb(25,29,38); border-radius: 8px; }
.card-title { font-size: 18px; -unity-font-style: bold; margin-bottom: 10px; }
.primary-button {
    height: 44px;
    min-width: 230px;
    align-self: flex-start;
    margin-top: 14px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: rgb(82,99,151);
    border-width: 1px;
    border-color: rgb(105,122,176);
    border-radius: 7px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.primary-button:hover {
    background-color: rgb(96,115,174);
    border-color: rgb(129,146,199);
}
.primary-button:active {
    background-color: rgb(66,81,126);
    border-color: rgb(90,106,158);
}
.primary-button:focus {
    border-color: rgb(180,190,224);
}

.notification-controls {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}
.notification-button {
    margin-top: 0;
}
.status-indicator {
    height: 32px;
    flex-direction: row;
    align-items: center;
    margin-left: 12px;
    padding-left: 12px;
    padding-right: 12px;
    border-width: 1px;
    border-radius: 16px;
}
.status-indicator__dot {
    width: 8px;
    height: 8px;
    margin-right: 8px;
    border-radius: 4px;
}
.status-indicator__label {
    -unity-font-style: bold;
}
.status-indicator--enabled {
    background-color: rgb(28, 52, 43);
    border-color: rgb(54, 103, 80);
}
.status-indicator--enabled > .status-indicator__dot {
    background-color: rgb(91, 194, 139);
}
.status-indicator--enabled > .status-indicator__label {
    color: rgb(164, 226, 191);
}
.status-indicator--disabled {
    background-color: rgb(43, 46, 55);
    border-color: rgb(69, 74, 88);
}
.status-indicator--disabled > .status-indicator__dot {
    background-color: rgb(124, 131, 150);
}
.status-indicator--disabled > .status-indicator__label {
    color: rgb(174, 180, 196);
}
.value { font-size: 30px; -unity-font-style: bold; margin-top: 8px; }
.muted { color: rgb(144,151,171); white-space: normal; }
.field-label { color: rgb(125,133,156); margin-top: 10px; }
.field-value { font-size: 16px; margin-bottom: 8px; }
